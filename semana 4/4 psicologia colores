<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mobile First</title>

  <style>
    body {
      font-family: Arial;
      margin: 0;
    }

    header {
      background: #222;
      color: white;
      padding: 20px;
    }

    .menu {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .contenedor {
      display: grid;
      grid-template-columns: 1fr;
      gap: 15px;
      padding: 15px;
    }

    .card {
      background: lightblue;
      padding: 30px;
    }

    @media (min-width: 768px) {
      .menu {
        flex-direction: row;
      }

      .contenedor {
        grid-template-columns: repeat(3, 1fr);
      }
    }
  </style>
</head>
<body>

  <header>
    <h1>Mi pagina</h1>

    <nav class="menu">
      <a href="#">Inicio</a>
      <a href="#">Servicios</a>
      <a href="#">Contacto</a>
    </nav>
  </header>

  <main class="contenedor">
    <div class="card">Tarjeta 1</div>
    <div class="card">Tarjeta 2</div>
    <div class="card">Tarjeta 3</div>
  </main>

</body>
</html>